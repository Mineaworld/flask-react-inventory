# Local XAMPP/MariaDB connection strings. Add the password after `root:` when configured.
# Keep real credentials in backend/.env and never commit that file.
DATABASE_URL=mysql+mysqldb://root@127.0.0.1:3307/inventorysystem?charset=utf8mb4
TEST_DATABASE_URL=mysql+mysqldb://root@127.0.0.1:3307/inventorysystem_test?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
# memory:// is suitable only for this local development setup.
RATELIMIT_STORAGE_URI=memory://
FLASK_ENV=development
